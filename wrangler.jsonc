{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "after-hours",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-14",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterhours-memory",
      "database_id": "746dadef-ca84-45ca-aca4-d9da53ab093a"
    }
  ]
}
